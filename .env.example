.env.example# Environment Variables for Material Scraping

# Moodle Credentials via Azure AD (Optional - can be passed as command line arguments)
MOODLE_USER=your-email@student.gla.ac.uk
MOODLE_PASS=your_password

# Scraping Configuration
SCRAPE_DELAY=2000
DOWNLOAD_TIMEOUT=30000
MAX_RETRIES=3

# Login Timeouts (Azure AD can be slow)
LOGIN_TIMEOUT=30000
NAVIGATION_TIMEOUT=15000

# Proxy Settings (if required by university)
# HTTP_PROXY=http://proxy.gla.ac.uk:8080
# HTTPS_PROXY=http://proxy.gla.ac.uk:8080

# Translation Providers (set at least one)
# Agnes AI: free, OpenAI-compatible, unlimited. Key from https://platform.agnes-ai.com
AGNES_API_KEY=sk-your-agnes-key
# AGNES_API_ENDPOINT=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-2.0-flash

# ModelScope (optional fallback)
# MODELSCOPE_API_KEY=your-modelscope-key
# MODELSCOPE_API_ENDPOINT=https://api-inference.modelscope.cn/v1
